# Browser-visible configuration only. Never add database URLs or secrets.
# Blank uses the same origin; the local Vite proxy targets port 3000.
# Production example format: https://api.<your-domain>/api/v1
VITE_API_URL=
# Reserved for future live monitoring; no WebSocket backend exists yet.
VITE_WS_URL=
# Optional Firebase Authentication transition. These are public web-app values.
# Keep false until the matching backend bridge is configured and verified.
VITE_FIREBASE_AUTH_BRIDGE=false
VITE_FIREBASE_AUTH_NATIVE=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Local development only: VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
