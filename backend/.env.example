# Separate Node configuration. Never replace the legacy root .env.
# Supply a real, empty PostgreSQL target before the first import.
NODE_DATABASE_URL=
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Used only by firebase/prepare-runtime.mjs; local CORS stays separate.
HOSTED_CORS_ORIGINS=
HOSTED_PUBLIC_BASE_URL=
HOSTED_PG_POOL_MAX=2
SESSION_HOURS=8
ADMIN_IDLE_MINUTES=30

# Optional Firebase identity transition. Keep disabled until emulator validation
# and a reviewed Firebase project are ready. ADC credentials are server-only.
FIREBASE_AUTH_BRIDGE_ENABLED=false
FIREBASE_AUTH_NATIVE_ENABLED=false
# Public API key, required only for native Firebase password sign-in in the interactive CLI.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# Development only: FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Hosted server: GOOGLE_APPLICATION_CREDENTIALS=/private/service-account.json

# Preserve the original Python Fernet key for imported authenticator profiles.
# Supply either the original base64 key privately or an absolute legacy key path.
# New installations may generate 32 bytes with Node's crypto.randomBytes.
APP_ENCRYPTION_KEY=
# APP_KEY_FILE=C:/AASTData/secret.key

# API rate limiter: currently per process, plus database-backed user lockout.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Target production transport is Workspace Gmail API. Retain old providers until verified migration.
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
# Gmail API: provision OAuth consent with ONLY gmail.send. Never put tokens in VITE variables.
GMAIL_MAILBOX=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_MAX_PER_MINUTE=20
GMAIL_MAX_PER_DAY=400
# Optional SMTP instead of Resend. Credentials are server-only; sender must be
# verified by that provider. TLS is mandatory (465 implicit or 587 STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Aiven CA is a private deployment file or server-only PEM environment value.
PG_SSL=false
PG_CA_FILE=
PG_CA_CERT=
PG_POOL_MAX=10
# Cloud Run only: managed Cloud SQL Auth Proxy Unix socket. Database URL uses
# postgresql://runtime-user:private-password@localhost/database without URL options.
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-id
# Review Prisma migrations separately; use verify-full + CA in this URL.
PRISMA_MIGRATION_DATABASE_URL=
# Render alone: one trusted proxy hop; local development: 0.
# Review again if Cloudflare proxying adds another hop.
TRUST_PROXY_HOPS=0
# Existing Gmail remains configured in the legacy app's private .env.
## Optional public-invitation bot protection; keep secret server-side.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=dream-team-peach.vercel.app
