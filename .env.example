DATABASE_URL=sqlite:///data/aast.db
APP_TIMEZONE=Africa/Cairo
SESSION_HOURS=8
# Server-side inactivity timeout for the administration interface (5-240 minutes).
ADMIN_IDLE_MINUTES=30
# Optional Fernet key. If blank, the app creates data/secret.key on enrollment.
# Keep the key private and back it up separately; never regenerate a key in use.
APP_ENCRYPTION_KEY=
# Optional absolute path instead of the default data/secret.key.
# APP_KEY_FILE=C:/AASTData/secret.key
# Wallet stays disabled until a signed-pass provider is implemented and configured.
# You can configure these privately in Settings > Ticket email delivery.
GMAIL_ENABLED=false
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=Dream Events
