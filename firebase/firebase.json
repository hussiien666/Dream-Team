{
  "functions": [{ "source": "functions", "codebase": "dream-events", "runtime": "nodejs22", "ignore": ["node_modules", ".git", "*-debug.log", ".secret.local", ".env*"] }],
  "hosting": {
    "site": "dream-team-bed27", "public": "public", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "/api/**", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/scan/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
    ],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "europe-west1" } },
      { "source": "/scan/**", "function": { "functionId": "api", "region": "europe-west1" } }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8088 },
    "storage": { "host": "127.0.0.1", "port": 9199 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
